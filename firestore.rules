rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function tripPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    function activityPath(tripId, activityId) {
      return /databases/$(database)/documents/trips/$(tripId)/activities/$(activityId);
    }

    function ownsTrip(tripId) {
      return signedIn()
        && exists(tripPath(tripId))
        && get(tripPath(tripId)).data.ownerId == request.auth.uid;
    }

    function hasExactly(data, required, optional) {
      return data.keys().hasAll(required) && data.keys().hasOnly(required.concat(optional));
    }

    function isText(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }

    function isDate(value) {
      return value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    function isTime(value) {
      return value is string && value.matches('([01][0-9]|2[0-3]):[0-5][0-9]');
    }

    function isMinorAmount(value, minimum) {
      return value is int && value >= minimum && value <= 1000000000000;
    }

    function validTrip(data) {
      return hasExactly(data, ['name', 'destination', 'startDate', 'endDate', 'timeZone', 'currencyCode', 'budgetMinor', 'ownerId', 'updatedAt'], ['archived', 'completedDayDates'])
        && isText(data.name, 1, 70)
        && isText(data.destination, 1, 80)
        && isDate(data.startDate)
        && isDate(data.endDate)
        && data.endDate >= data.startDate
        && isText(data.timeZone, 1, 64)
        && data.currencyCode in ['USD', 'CAD', 'EUR', 'GBP', 'JPY', 'AUD', 'PHP']
        && isMinorAmount(data.budgetMinor, 0)
        && (!('archived' in data) || data.archived is bool)
        && (!('completedDayDates' in data) || (data.completedDayDates is list && data.completedDayDates.size() <= 366))
        && data.ownerId == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validLocation(location) {
      return location is map
        && hasExactly(location, ['label', 'latitude', 'longitude'], ['searchTerm'])
        && isText(location.label, 1, 200)
        && location.latitude is number && location.latitude >= -90 && location.latitude <= 90
        && location.longitude is number && location.longitude >= -180 && location.longitude <= 180
        && (!('searchTerm' in location) || isText(location.searchTerm, 1, 200));
    }

    function validPhoto(photo) {
      return photo is map
        && hasExactly(photo, ['id', 'name', 'mimeType', 'size'], [])
        && isText(photo.id, 1, 128)
        && isText(photo.name, 1, 120)
        && photo.mimeType is string && photo.mimeType.matches('image/.*')
        && isMinorAmount(photo.size, 1) && photo.size <= 5242880;
    }

    function validPhotos(photos) {
      return photos is list
        && photos.size() <= 5
        && (photos.size() < 1 || validPhoto(photos[0]))
        && (photos.size() < 2 || validPhoto(photos[1]))
        && (photos.size() < 3 || validPhoto(photos[2]))
        && (photos.size() < 4 || validPhoto(photos[3]))
        && (photos.size() < 5 || validPhoto(photos[4]));
    }

    function validActivity(data) {
      return hasExactly(data, ['title', 'date', 'startTime', 'endTime', 'category', 'notes'], ['location', 'outfitOfDay', 'outfitNotes', 'outfitPhoto', 'photos'])
        && isText(data.title, 1, 90)
        && isDate(data.date)
        && isTime(data.startTime)
        && isTime(data.endTime)
        && data.endTime > data.startTime
        && data.category in ['Explore', 'Food', 'Stay', 'Transit']
        && isText(data.notes, 0, 400)
        && (!('location' in data) || validLocation(data.location))
        && (!('outfitOfDay' in data) || data.outfitOfDay is bool)
        && (!('outfitNotes' in data) || isText(data.outfitNotes, 0, 300))
        && (!('outfitPhoto' in data) || data.outfitPhoto == null || validPhoto(data.outfitPhoto))
        && (!('photos' in data) || validPhotos(data.photos));
    }

    // Rules cannot iterate list entries, so the app verifies that split shares sum to the total.
    function validExpense(tripId, data) {
      return hasExactly(data, ['title', 'date', 'amountMinor', 'paidBy', 'splits'], ['activityId'])
        && isText(data.title, 1, 80)
        && isDate(data.date)
        && isMinorAmount(data.amountMinor, 1)
        && isText(data.paidBy, 1, 60)
        && data.splits is list
        && data.splits.size() >= 1
        && data.splits.size() <= 30
        && (!('activityId' in data) || (isText(data.activityId, 1, 128) && exists(activityPath(tripId, data.activityId))));
    }

    match /trips/{tripId} {
      allow get, list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && validTrip(request.resource.data);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && validTrip(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /activities/{activityId} {
        allow read, delete: if ownsTrip(tripId);
        allow create, update: if ownsTrip(tripId) && validActivity(request.resource.data);
      }

      match /expenses/{expenseId} {
        allow read, delete: if ownsTrip(tripId);
        allow create, update: if ownsTrip(tripId) && validExpense(tripId, request.resource.data);
      }
    }
  }
}

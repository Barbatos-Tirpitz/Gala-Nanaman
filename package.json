{
  "name": "gala-nanaman",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:rules": "firebase emulators:exec --project demo-gala-nanaman-rules-test --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "mobile:sync": "npm run build && cap sync",
    "mobile:sync:android": "npm run build && cap sync android",
    "mobile:sync:ios": "npm run build && cap sync ios",
    "mobile:add:android": "cap add android",
    "mobile:add:ios": "cap add ios"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^7.3.0",
    "@capacitor/core": "^7.4.3",
    "firebase": "^11.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.65.1",
    "@types/leaflet": "^1.9.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.8",
    "firebase-tools": "^14.12.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.7"
  }
}
